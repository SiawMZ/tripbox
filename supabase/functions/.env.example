# Copy to supabase/functions/.env (local) or set with `npx supabase secrets set` (hosted).
# Used by tripbox-import. Set a monthly spend limit on the Anthropic key and a budget alert on Google Cloud.
ANTHROPIC_API_KEY=
# Google Maps Platform key with "Places API (New)" enabled, restricted to that API.
GOOGLE_MAPS_API_KEY=
# Optional: model for place extraction, and import limits.
# EXTRACT_MODEL=claude-haiku-5-5
# TRIPBOX_IMPORTS_PER_HOUR=30
# TRIPBOX_IMPORTS_PER_DAY=150
# TRIPBOX_IMPORTS_PER_DAY_ALL=2000
# Opening-hours checks a month ("Plan my days": one per place); the second keeps everyone inside Google's free 1,000.
# TRIPBOX_HOURS_PER_MONTH=300
# TRIPBOX_HOURS_PER_MONTH_ALL=950
