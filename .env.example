EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<publishable or anon key>

# Public address of the hosted web app, used for shared-folder links (e.g. https://linkbox.expo.app).
EXPO_PUBLIC_WEB_URL=

# Google maps on the trip screen (step 3). Two separate keys, neither is the server's Places key:
# - Web: a browser key restricted to "Maps JavaScript API" and the Tripbox website's address (and localhost for testing).
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=
# - Android: restricted to "Maps SDK for Android", package com.siawmz.tripbox and the build's SHA-1.
#   Read by app.config.ts at build time (set it as an EAS environment variable for cloud builds).
GOOGLE_MAPS_ANDROID_KEY=
