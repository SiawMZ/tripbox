{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spike",
      "runtimeExecutable": "deno",
      "runtimeArgs": [
        "task",
        "--cwd",
        "spike",
        "serve"
      ],
      "port": 8095
    },
    {
      "name": "web-local",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".claude/web-local.mjs"
      ],
      "port": 8090
    },
    {
      "name": "web-hosted",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8091"
      ],
      "port": 8091
    }
  ]
}