{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spike-map",
      "runtimeExecutable": "deno",
      "runtimeArgs": ["run", "--allow-net", "--allow-read=spike", "jsr:@std/http@1/file-server", "spike", "--port", "8095", "--host", "127.0.0.1"],
      "port": 8095
    },
    {
      "name": "web-local",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".claude/web-local.mjs"
      ],
      "port": 8090
    },
    {
      "name": "web-hosted",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8091"
      ],
      "port": 8091
    }
  ]
}
